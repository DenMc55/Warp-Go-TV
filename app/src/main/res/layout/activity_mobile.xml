<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mobile_title"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:text="●  Disconnected"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/toggleButton"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/toggle_button_background"
            android:clickable="true"
            android:gravity="center"
            android:text="@string/connect"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/connection_port"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/port_help"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/portGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/port4500"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="@color/radio_tint"
                android:checked="true"
                android:gravity="center_vertical"
                android:text="@string/port_4500"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/port2408"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="@color/radio_tint"
                android:gravity="center_vertical"
                android:text="@string/port_2408"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/port500"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="@color/radio_tint"
                android:gravity="center_vertical"
                android:text="@string/port_500"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
        </RadioGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoConnectSwitch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:text="@string/auto_connect_boot"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            app:thumbTint="@color/switch_thumb_tint"
            app:trackTint="@color/switch_track_tint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/auto_connect_help_short"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:gravity="center"
            android:text="@string/reset_account"
            android:textAllCaps="false"
            android:textColor="@color/warp_orange"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/port_switch_note"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
